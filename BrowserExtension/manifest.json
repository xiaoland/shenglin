{
  "manifest_version": 3,
  "name": "声邻网页协同",
  "version": "0.2.0",
  "description": "保留通话网页输出，按声邻本机策略降低已授权的背景网页。音频仅在浏览器内处理。",
  "key": "",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "声邻网页协同"
  }
}
