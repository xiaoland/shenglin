{
  "name": "shenglin-browser-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "test": "pnpm run build && vitest run && node --experimental-vm-modules ../scripts/test-browser-coordination.cjs && node ../scripts/test-browser-build.cjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@wxt-dev/module-vue": "1.0.3",
    "jsdom": "30.1.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@11.20.0"
}
